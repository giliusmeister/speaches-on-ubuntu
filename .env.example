APP_HOST=127.0.0.1
APP_PORT=18000
NGINX_HTTP_PORT=18080
NGINX_API_PORT=8102
NGINX_SERVER_NAME=_

SPEACHES_HOST=127.0.0.1
SPEACHES_PORT=8101
OPENLINGO_STT_ADAPTER_HOST=127.0.0.1
OPENLINGO_STT_ADAPTER_PORT=8103
FASTER_WHISPER_HOST=127.0.0.1
FASTER_WHISPER_PORT=8104

# Set to your Ubuntu server's LAN IP or hostname for client-side examples.
LAN_HOST=192.168.11.11

# STT model passed through to Speaches/OpenAI-compatible endpoint.
SPEACHES_MODEL=Systran/faster-distil-whisper-small.en

# TTS model and voice for Speaches.
SPEACHES_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
SPEACHES_TTS_VOICE=af_heart
TTS__MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS__INFERENCE_DEVICE=auto

# Optional for SDKs that insist on a non-empty key.
OPENAI_API_KEY=not-empty

# Adapter settings
SPEACHES_BASE_URL=http://127.0.0.1:8101/v1
OPENLINGO_RESPONSE_FORMAT=verbose_json

# Faster-Whisper fallback settings
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER__MODEL=Systran/faster-whisper-small
WHISPER__NUM_WORKERS=1

# Speaches runs as root in the provided systemd unit.
HF_HUB_CACHE=/root/.cache/huggingface/hub
VAD__MODEL=silero_vad_v5

# Keep frequently used speech models warm on a small LAN server.
# -1 means never unload after use; upstream defaults are 300 seconds for STT/TTS and -1 for VAD.
STT_MODEL_TTL=-1
TTS_MODEL_TTL=300
VAD_MODEL_TTL=-1

# Optional startup downloads. Keep this JSON-style list aligned with your selected models.
PRELOAD_MODELS='["Systran/faster-distil-whisper-small.en","Systran/faster-whisper-small"]'
