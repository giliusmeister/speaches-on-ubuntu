[Unit]
Description=Speaches OpenAI-compatible STT/TTS server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/speaches
Environment=PATH=/opt/speaches/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/speaches/.venv/bin/uvicorn --factory --host 0.0.0.0 --port 8000 speaches.main:create_app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
