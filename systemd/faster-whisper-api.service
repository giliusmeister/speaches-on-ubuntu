[Unit]
Description=Faster Whisper API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/speaches-on-ubuntu
EnvironmentFile=/opt/speaches-on-ubuntu/.env
ExecStart=/opt/speaches-on-ubuntu/services/faster-whisper-api/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
