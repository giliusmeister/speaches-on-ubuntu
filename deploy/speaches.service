[Unit]
Description=Speaches OpenAI-compatible STT/TTS server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/speaches
EnvironmentFile=/opt/speaches-on-ubuntu/.env
Environment=PATH=/opt/speaches/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/speaches-on-ubuntu/scripts/run-speaches.sh
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/speaches /tmp

[Install]
WantedBy=multi-user.target
